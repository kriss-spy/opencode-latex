{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-latex",
  "version": "0.2.0",
  "description": "Render LaTeX from OpenCode agent messages as terminal images.",
  "type": "module",
  "license": "MIT",
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.9",
    "opentui-math": "0.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.11",
    "@types/bun": "^1.2.23",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["opencode", "opencode-plugin", "latex", "math", "tui"]
}
