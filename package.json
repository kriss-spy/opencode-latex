{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-latex",
  "version": "0.2.1",
  "description": "Render LaTeX from OpenCode agent messages as terminal images.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "docs/images",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.2",
    "opentui-math": "0.1.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.7.0 <0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.7.0",
    "@types/bun": "^1.2.23",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "latex",
    "math",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriss-spy/opencode-latex.git"
  },
  "bugs": {
    "url": "https://github.com/kriss-spy/opencode-latex/issues"
  },
  "homepage": "https://github.com/kriss-spy/opencode-latex#readme"
}
